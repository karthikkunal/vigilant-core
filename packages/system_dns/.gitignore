# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# pubspec.lock is normally excluded from a library, per
# https://dart.dev/guides/libraries/private-files#pubspeclock. That guidance
# covers packages published to pub.dev; this one is publish_to: none and is
# only ever resolved as a path dependency of the app. F-Droid additionally
# rejects a source tree where any pubspec.yaml lacks a lockfile, so the lock is
# tracked here.
/pubspec.lock
!/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
